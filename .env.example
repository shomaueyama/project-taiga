# Local-only application mode. LocalAuth must not be enabled outside APP_ENV=local.
APP_ENV=local
LOCAL_AUTH_ENABLED=true

# Local PostgreSQL connection used by backend and worker containers.
DATABASE_URL=postgresql+psycopg://taiga:taiga@postgres:5432/taiga

# Local filesystem mounts used by uploads, artifacts, results, and hidden tests.
LOCAL_STORAGE_ROOT=/workspace/local-storage
CURRICULUM_SOURCE_DIR=/workspace/curriculum

# Safety defaults. Keep disabled unless the corresponding hostile/safety tests pass.
RUNNER_ENABLED=false
EXAM_ENABLED=false

# Local timezone and frontend API target.
TZ=Asia/Tokyo
VITE_API_BASE_URL=http://localhost:8000
